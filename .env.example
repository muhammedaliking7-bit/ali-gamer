# ==============================================================================
# NEXUS REALM - Environment Configuration Template
# ==============================================================================
# IMPORTANT: Never commit credentials, connection strings, or service secrets.
#
# 1. Neon PostgreSQL Database Connection String
# Example: postgresql://[user]:[password]@[neon-host]/[dbname]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:your-password@ep-your-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require

# 2. Server Configuration
PORT=8080
NODE_ENV=production

# 3. Supabase Auth Configuration (Client-side / optional auth provider)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-public-key-placeholder

# 4. Application Site URL & Redirect URLs
# Site URL: http://localhost:8080
# Redirect URLs:
#   http://localhost:8080
#   http://localhost:8080/#auth?mode=reset
#   http://localhost:8080/#auth
